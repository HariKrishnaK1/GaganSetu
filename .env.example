# GaganSetu Server & Database Configuration
PORT=5050

# MongoDB Atlas Connection String
# Replace with your MongoDB Atlas cluster connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/gagansetu?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gagansetu?retryWrites=true&w=majority
